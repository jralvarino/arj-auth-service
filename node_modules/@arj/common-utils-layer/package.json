{
    "name": "@arj/common-utils-layer",
    "version": "1.0.4",
    "author": "Alvarino Ribeiro Junior",
    "license": "MIT",
    "description": "Common utilities shared via Lambda layer.",
    "files": [
        "dist"
    ],
    "exports": {
        "./util": {
            "types": "./dist/util/index.d.ts",
            "require": "./dist/util/index.js",
            "import": "./dist/util/index.js"
        },
        "./db": {
            "types": "./dist/db/index.d.ts",
            "require": "./dist/db/index.js",
            "import": "./dist/db/index.js"
        },
        "./model": {
            "types": "./dist/model/index.d.ts",
            "require": "./dist/model/index.js",
            "import": "./dist/model/index.js"
        },
        "./error": {
            "types": "./dist/error/index.d.ts",
            "require": "./dist/error/index.js",
            "import": "./dist/error/index.js"
        },
        "./middleware": {
            "types": "./dist/middleware/index.d.ts",
            "require": "./dist/middleware/index.js",
            "import": "./dist/middleware/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "prepublishOnly": "npm run build",
        "publish:artifact": "npm run build && npm publish"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "devDependencies": {
        "@types/aws-lambda": "^8.10.159",
        "@types/node": "^22.0.0",
        "@eslint/js": "^9.0.0",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^9.0.0",
        "prettier": "^3.4.0",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.0.0"
    },
    "dependencies": {
        "@aws-lambda-powertools/logger": "^2.0.0",
        "@aws-sdk/client-dynamodb": "^3.956.0",
        "@aws-sdk/client-secrets-manager": "^3.966.0",
        "@aws-sdk/lib-dynamodb": "^3.956.0",
        "@middy/core": "^6.4.5",
        "@middy/validator": "^6.4.5",
        "zod": "^4.0.0"
    },
    "peerDependencies": {
        "@types/aws-lambda": ">=8.0.0"
    },
    "peerDependenciesMeta": {
        "@types/aws-lambda": {
            "optional": true
        }
    }
}
